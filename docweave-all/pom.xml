<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.docweave</groupId>
        <artifactId>docweave-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>docweave</artifactId>
    <name>DocWeave all</name>
    <properties><docweave.javadoc.skip>true</docweave.javadoc.skip></properties>
    <dependencies>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-json</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-chunking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-batch</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-txt</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-html</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-markdown</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-csv</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-tsv</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-xml</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-docx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.docweave</groupId>
            <artifactId>docweave-pdf</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>release-artifacts</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions><execution>
                    <id>attach-convenience-documentation</id>
                    <phase>package</phase>
                    <goals><goal>jar</goal></goals>
                    <configuration>
                        <!-- This resource-only dependency bundle has no Java API to pass to the Javadoc tool. -->
                        <classifier>javadoc</classifier>
                        <includes><include>META-INF/LICENSE</include><include>META-INF/README.md</include><include>META-INF/THIRD_PARTY_NOTICES.md</include></includes>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
