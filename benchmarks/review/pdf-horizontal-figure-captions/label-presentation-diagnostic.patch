     /**
+     * Diagnoses only source label styling; never changes output, reference bodies or strict equality credit.
+     * @param unit complete classified native unit, ASCII whitespace normalized by the frozen scorer
+     * @param sourceLabel unchanged source publisher label under the same ASCII normalization
+     * @param caption complete unchanged publisher caption
+     * @return whether a terminal label period and horizontal separator explain the whole difference
+     */
+    private static boolean presentationOnly(final String unit, final String sourceLabel, final String caption) {
+        if (!sourceLabel.matches("(?:Fig(?:ure)?\\.?|FIG(?:URE)?\\.?)[\\p{Zs}\\t]+[1-9][0-9]{0,2}[A-Za-z]?\\.?")) {
+            return false;
+        }
+        final String marker = sourceLabel.endsWith(".") ? sourceLabel : sourceLabel + ".";
+        if (!unit.startsWith(marker)) {
+            return false;
+        }
+        int offset = marker.length();
+        final int start = offset;
+        while (offset < unit.length()) {
+            final int point = unit.codePointAt(offset);
+            if (point != '\t' && Character.getType(point) != Character.SPACE_SEPARATOR) {
+                break;
+            }
+            offset += Character.charCount(point);
+        }
+        return offset > start && unit.substring(offset).equals(caption);
+    }
+
+    /** Checks presentation diagnosis cannot excuse added body text, changed labels, vertical breaks or punctuation. */
+    private static void presentationControls() {
+        require(presentationOnly("Fig 1.\u2002Body", "Fig 1", "Body"), "Owned label spacing diagnosis failed");
+        require(!presentationOnly("Fig 1.\u2002Body extra", "Fig 1", "Body"), "Extra body text hidden");
+        require(!presentationOnly("Fig 2.\u2002Body", "Fig 1", "Body"), "Changed label hidden");
+        require(!presentationOnly("Fig 1.\nBody", "Fig 1", "Body"), "Vertical break hidden");
+        require(!presentationOnly("Fig 1.\u2002Body!", "Fig 1", "Body"), "Changed body punctuation hidden");
+    }
