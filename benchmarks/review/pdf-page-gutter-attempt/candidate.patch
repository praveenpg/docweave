+++ b/docweave-ocr-tesseract/src/main/java/dev/docweave/ocr/TesseractPageGutter.java
@@ -0,0 +1,90 @@
+package dev.docweave.ocr;
+
+import dev.docweave.partition.PdfWordOcrProvider;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.TreeMap;
+
+/** Bounded sweep of repeatedly observed word gaps; no pixels, models or reference text are inspected. */
+final class TesseractPageGutter {
+    /** Prevents construction. */
+    private TesseractPageGutter() {
+    }
+
+    /**
+     * One gap edge and the source line top that supports it.
+     * @param top source line top coordinate
+     * @param delta admission or removal count
+     */
+    private record Edge(double top, int delta) {}
+
+    /**
+     * Chooses one central gap supported by four vertically separated source lines, or declines.
+     * @param lines original recognition-ordered word populations
+     * @param width source raster width
+     * @param deadline shared recognition deadline and interruption check
+     * @return gutter midpoint or NaN if evidence is insufficient
+     * @throws IOException if cancelled or timed out
+     */
+    static double locate(final List<List<PdfWordOcrProvider.Word>> lines, final int width, final OcrDeadline deadline)
+            throws IOException {
+        final var heights = new ArrayList<Double>();
+        for (final var line : lines) {
+            for (final var word : line) {
+                deadline.remaining();
+                heights.add(word.bottom() - word.top());
+            }
+        }
+        if (heights.isEmpty()) {
+            return Double.NaN;
+        }
+        heights.sort(Double::compare);
+        deadline.remaining();
+        final double height = heights.get(heights.size() / 2);
+        final var edges = new TreeMap<Double, List<Edge>>();
+        for (final var line : lines) {
+            double top = Double.POSITIVE_INFINITY;
+            for (final var word : line) {
+                deadline.remaining();
+                top = Math.min(top, word.top());
+            }
+            for (int i = 2; i <= line.size() - 2; i++) {
+                deadline.remaining();
+                final double left = Math.max(width * .25, line.get(i - 1).right());
+                final double right = Math.min(width * .75, line.get(i).left());
+                if (right - left >= height) {
+                    edges.computeIfAbsent(left, ignored -> new ArrayList<>()).add(new Edge(top, 1));
+                    edges.computeIfAbsent(right, ignored -> new ArrayList<>()).add(new Edge(top, -1));
+                }
+            }
+        }
+        final var active = new TreeMap<Double, Integer>();
+        int support = 0;
+        double bestWidth = 0;
+        double gutter = Double.NaN;
+        for (final var entry : edges.entrySet()) {
+            deadline.remaining();
+            for (final var edge : entry.getValue()) {
+                deadline.remaining();
+                final int count = active.getOrDefault(edge.top(), 0) + edge.delta();
+                if (count == 0) {
+                    active.remove(edge.top());
+                } else {
+                    active.put(edge.top(), count);
+                }
+            }
+            final Double right = edges.higherKey(entry.getKey());
+            if (right != null && active.size() >= 4 && active.lastKey() - active.firstKey() >= 4 * height) {
+                final double span = right - entry.getKey();
+                if (active.size() > support || active.size() == support && span > bestWidth) {
+                    support = active.size();
+                    bestWidth = span;
+                    gutter = (entry.getKey() + right) / 2;
+                }
+            }
+        }
+        return gutter;
+    }
+}
