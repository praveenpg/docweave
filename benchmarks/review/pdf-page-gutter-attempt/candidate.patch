index 0000000..562ea20
--- /dev/null
+++ b/docweave-ocr-tesseract/src/test/java/dev/docweave/ocr/TesseractPageGutterTest.java
@@ -0,0 +1,138 @@
+package dev.docweave.ocr;
+
+import dev.docweave.partition.PartitionException;
+import org.junit.jupiter.api.Test;
+
+import java.nio.charset.StandardCharsets;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/** Owned page-level gutter controls; no external engine is started. */
+class TesseractPageGutterTest {
+    /** Engine schema shared by the owned source rows. */
+    private static final String HEADER =
+            "level\tpage_num\tblock_num\tpar_num\tline_num\tword_num\tleft\ttop\twidth\theight\tconf\ttext\n";
+
+    /** Creates the owned source controls. */
+    TesseractPageGutterTest() {
+    }
+
+    /**
+     * A consistent narrow column gap splits while a wider intra-column gap stays in its source line.
+     * @throws Exception if parsing fails
+     */
+    @Test
+    void supportedGutterAvoidsIntraColumnSplits() throws Exception {
+        final String input = rows(4, false);
+        final var lines = parse(input, TesseractOptions.LineSplitting.PAGE_GUTTERS);
+        assertEquals(8, lines.size());
+        assertEquals("left words", lines.getFirst().text());
+        assertEquals("right words", lines.get(1).text());
+        assertEquals(400, lines.getFirst().right());
+        assertEquals(420, lines.get(1).left());
+        assertNotEquals(lines, parse(input, TesseractOptions.LineSplitting.WIDE_GAPS));
+    }
+
+    /**
+     * Fewer than four supporting lines retain the established wide-gap fallback.
+     * @throws Exception if parsing fails
+     */
+    @Test
+    void insufficientSupportRetainsFallback() throws Exception {
+        assertEquals(parse(rows(3, false), TesseractOptions.LineSplitting.WIDE_GAPS),
+                parse(rows(3, false), TesseractOptions.LineSplitting.PAGE_GUTTERS));
+    }
+
+    /**
+     * Several identities on the same physical baseline cannot manufacture page-level support.
+     * @throws Exception if parsing fails
+     */
+    @Test
+    void repeatedBaselineDoesNotManufactureSupport() throws Exception {
+        assertEquals(parse(rows(4, true), TesseractOptions.LineSplitting.WIDE_GAPS),
+                parse(rows(4, true), TesseractOptions.LineSplitting.PAGE_GUTTERS));
+    }
+
+    /**
+     * A numeric tab-stop row with only one right token cannot support the two-column hypothesis.
+     * @throws Exception if parsing fails
+     */
+    @Test
+    void singleNumericTabStopRetainsFallback() throws Exception {
+        final var text = new StringBuilder(HEADER);
+        for (int i = 1; i <= 4; i++) {
+            text.append(word(i, 10 + 20 * i, 100, 20, "left"));
+            text.append(word(i, 10 + 20 * i, 380, 20, "label"));
+            text.append(word(i, 10 + 20 * i, 420, 20, "12"));
+        }
+        assertEquals(parse(text.toString(), TesseractOptions.LineSplitting.WIDE_GAPS),
+                parse(text.toString(), TesseractOptions.LineSplitting.PAGE_GUTTERS));
+    }
+
+    /**
+     * The detailed view and output-line budget use exactly the same split decisions.
+     * @throws Exception if parsing fails
+     */
+    @Test
+    void detailedViewAndLineBudgetRemainConsistent() throws Exception {
+        final var options = TesseractOptions.defaults().withLineSplitting(TesseractOptions.LineSplitting.PAGE_GUTTERS);
+        final var words = TesseractTsv.parseWords(rows(4, false).getBytes(StandardCharsets.UTF_8), 1000, 200, options,
+                new OcrDeadline(options.timeout()));
+        assertEquals(8, words.size());
+        assertEquals(2, words.getFirst().words().size());
+        final var limited = new TesseractOptions(options.executable(), options.tessdataDirectory(), options.languages(),
+                options.timeout(), options.maxConcurrentProcesses(), options.maxImagePixels(), options.maxPngBytes(),
+                options.maxOutputBytes(), 7, options.maxCharacters())
+                                    .withLineSplitting(options.lineSplitting());
+        final var failure = assertThrows(PartitionException.class,
+                ()
+                        -> TesseractTsv.parse(rows(4, false).getBytes(StandardCharsets.UTF_8), 1000, 200, limited,
+                                new OcrDeadline(limited.timeout())));
+        assertEquals(PartitionException.Code.OCR_LIMIT, failure.code());
+    }
+
+    /**
+     * Builds independent physical rows with one central gap and intentionally wider internal spacing.
+     * @param count source line count
+     * @param sameBaseline whether all identities share one physical baseline
+     * @return complete TSV
+     */
+    private static String rows(final int count, final boolean sameBaseline) {
+        final var text = new StringBuilder(HEADER);
+        for (int i = 1; i <= count; i++) {
+            final int top = sameBaseline ? 10 : 10 + 20 * i;
+            text.append(word(i, top, 100, 20, "left"));
+            text.append(word(i, top, 380, 20, "words"));
+            text.append(word(i, top, 420, 20, "right"));
+            text.append(word(i, top, 450, 20, "words"));
+        }
+        return text.toString();
+    }
+
+    /**
+     * Parses owned source words under the selected policy.
+     * @param text complete TSV
+     * @param policy explicit splitting choice
+     * @return parsed lines
+     * @throws Exception if parsing fails
+     */
+    private static java.util.List<dev.docweave.partition.PdfOcrProvider.Line> parse(
+            final String text, final TesseractOptions.LineSplitting policy) throws Exception {
+        final var options = TesseractOptions.defaults().withLineSplitting(policy);
+        return TesseractTsv.parse(
+                text.getBytes(StandardCharsets.UTF_8), 1000, 200, options, new OcrDeadline(options.timeout()));
+    }
+
+    /**
+     * Builds one source token without deriving expected line geometry from the candidate.
+     * @param line source line identity
+     * @param top source vertical edge
+     * @param left horizontal edge
+     * @param width word width
+     * @param text recognized content
+     * @return one TSV row
+     */
+    private static String word(final int line, final int top, final int left, final int width, final String text) {
+        return "5\t1\t1\t1\t" + line + "\t1\t" + left + "\t" + top + "\t" + width + "\t10\t90\t" + text + "\n";
+    }
+}
